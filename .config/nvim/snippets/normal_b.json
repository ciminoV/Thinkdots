{
  "LaTeX article template": {
    "prefix": "template",
    "body": [
      "\\documentclass[a4paper,11pt]{article}",
      "",
      "\\usepackage[utf8]{inputenc}",
      "\\usepackage{amsmath, amssymb}",
      "\\usepackage{imakeidx}",
      "\\usepackage{graphicx}",
      "\\usepackage{fancyhdr}",
      "\\graphicspath{ {./images/} }",
      "%%%%%%%%%%%%%%%%%% Margins %%%%%%%%%%%%%%%%%%%%%%",
      "\\topmargin = 0cm",
      "\\evensidemargin = -1cm",
      "\\oddsidemargin = -1cm",
      "\\textheight = 23cm",
      "\\textwidth = 18cm",
      "",
      "%%%%%%%%%%%%%%%%%% Margins %%%%%%%%%%%%%%%%%%%%%%",
      "\\renewcommand{\\familydefault}{phv}",
      "",
      "%%%%%%%%%%%%%%%%%% Numbering equation with respect to section %%%%%%%%%%%%%%%%%%%%%%",
      "\\numberwithin{equation}{subsection}",
      "",
      "\\let\\oldsection\\section% Store \\section",
      "\\renewcommand{\\section}{% Update \\section",
      "  \\renewcommand{\\theequation}{\\thesection.\\arabic{equation}}% Update equation number",
      "  \\oldsection}% Regular \\section",
      "\\let\\oldsubsection\\subsection% Store \\subsection",
      "\\renewcommand{\\subsection}{% Update \\subsection",
      "  \\renewcommand{\\theequation}{\\thesubsection.\\arabic{equation}}% Update equation number",
      "  \\oldsubsection}% Regular \\subsection",
      "%%%%%%%%%%%%%%%%%% Numbering equation with respect to section %%%%%%%%%%%%%%%%%%%%%%",
      "",
      "%%%%%%%%%%%%%%%%%% Pages header %%%%%%%%%%%%%%%%%%%%%%",
      "\\pagestyle{fancy}",
      "\\fancyhf{}",
      "\\fancyhead[LE,RO]{\\leftmark}",
      "\\fancyhead[LO,RE]{\\rightmark}",
      "\\setlength{\\headheight}{5pt}",
      "%%%%%%%%%%%%%%%%%% Pages header %%%%%%%%%%%%%%%%%%%%%%",
      "",
      "\\title{${1}}",
      "\\author{${2:Vincenzo Cimino}}",
      "\\date{$CURRENT_YEAR}",
      "",
      "\\begin{document}",
      "\\begin{titlepage}",
      "\\maketitle",
      "\\end{titlepage}",
      "",
      "\\tableofcontents",
      "",
      "\\clearpage",
      "",
      "$0",
      "",
      "",
      "\\end{document}"
    ],
    "description": "Complete LaTeX article template"
  },

  "Exercise block": {
    "prefix": "exercise",
    "body": [
      "\\textbf{\\textit{Exercise${1}}}",
      "",
      "\\begin{tcolorbox}[colback=lightgray!50]",
      "${2}",
      "\\end{tcolorbox}",
      "",
      "${3}",
      "\\par\\noindent\\rule{\\textwidth}{0.4pt}",
      "",
      "$0"
    ],
    "description": "Insert an exercise block"
  },

  "Example block": {
    "prefix": "example",
    "body": [
      "",
      "\\par\\noindent\\rule{\\textwidth}{0.4pt}",
      "",
      "\\textbf{\\textit{Example${1}}} ",
      "\\textit{${2}}",
      "${3}",
      "\\par\\noindent\\rule{\\textwidth}{0.4pt}",
      "",
      "$0"
    ],
    "description": "Insert an example block"
  }
}
