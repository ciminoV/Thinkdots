#!/bin/sh

# Kill already running duplicate process
pkill gammashift dwlb mako swaybg

dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP=wlroots

gammastep &

swaybg --output '*' --mode stretch  --image $HOME/Pictures/wp7287342.jpg &

mako &

foot --server &

dwlb &

$HOME/.local/bin/status-bar &
