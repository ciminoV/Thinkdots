#!/bin/sh

# A wmenu wrapper script for system functions

ctl="systemctl"

case "$(printf "1: sleep\n2: shutdown\n3: reboot" | wmenu -i -p 'See you soon: ' -l 3)" in
	#'sleep') slock $ctl suspend -i ;;
	'1: sleep') $ctl suspend -i ;;
	'2: shutdown') $ctl poweroff -i ;;
	'3: reboot') $ctl reboot -i ;;
	*) exit 1 ;;
esac
